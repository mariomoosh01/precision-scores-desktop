<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Host\Host.csproj" />
    <ProjectReference Include="..\Sync\Sync.csproj" />
    <ProjectReference Include="..\Scanner\Scanner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- React UI, produced by build/web.sh into vendor/web/app/. Each
         file is copied into the Shell's bin output under wwwroot/ so
         Kestrel's static-file middleware can serve it as /. If the
         vendor dir doesn't exist yet (first checkout), the glob is
         empty and the build still succeeds; Shell logs a warning at
         startup and the Photino window shows a placeholder page. -->
    <Content Include="..\..\vendor\web\app\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- Scanner sidecar (PyInstaller-built scanner binary + mnist.onnx)
         produced by build/scanner.sh|.ps1. Copied to bin/scanner/ so the
         Shell can launch it with Process.Start. Missing glob = scanner
         sidecar disabled, /match/scan-multi returns 503, frontend
         opencv.js fallback runs. -->
    <Content Include="..\..\vendor\scanner\**\*"
             Link="scanner\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PrecisionScoresDesktop.Shell</RootNamespace>
    <AssemblyName>PrecisionScoresDesktop.Shell</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
